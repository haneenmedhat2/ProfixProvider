<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="24412" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24405"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="MyAppointmentsVC" customModule="ProfixProvider" customModuleProvider="target">
            <connections>
                <outlet property="view" destination="root" id="out-view"/>
                <outlet property="dateLabel" destination="date" id="out-date"/>
                <outlet property="tableView" destination="table" id="out-table"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="root">
            <rect key="frame" x="0" y="0" width="393" height="852"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <label opaque="NO" contentMode="left" textAlignment="center" text="" translatesAutoresizingMaskIntoConstraints="NO" id="date">
                    <rect key="frame" x="20" y="75" width="353" height="24"/>
                    <fontDescription key="fontDescription" type="system" pointSize="20"/>
                </label>
                <tableView clipsSubviews="YES" contentMode="scaleToFill" alwaysBounceVertical="YES" style="plain" separatorStyle="singleLine" rowHeight="82" estimatedRowHeight="82" translatesAutoresizingMaskIntoConstraints="NO" id="table">
                    <rect key="frame" x="0" y="119" width="393" height="699"/>
                </tableView>
            </subviews>
            <viewLayoutGuide key="safeArea" id="safe"/>
            <constraints>
                <constraint firstItem="date" firstAttribute="top" secondItem="safe" secondAttribute="top" constant="16" id="date-top"/>
                <constraint firstItem="date" firstAttribute="leading" secondItem="safe" secondAttribute="leading" constant="20" id="date-leading"/>
                <constraint firstItem="safe" firstAttribute="trailing" secondItem="date" secondAttribute="trailing" constant="20" id="date-trailing"/>
                <constraint firstItem="table" firstAttribute="top" secondItem="date" secondAttribute="bottom" constant="20" id="table-top"/>
                <constraint firstItem="table" firstAttribute="leading" secondItem="safe" secondAttribute="leading" id="table-leading"/>
                <constraint firstItem="table" firstAttribute="trailing" secondItem="safe" secondAttribute="trailing" id="table-trailing"/>
                <constraint firstItem="table" firstAttribute="bottom" secondItem="safe" secondAttribute="bottom" id="table-bottom"/>
            </constraints>
        </view>
    </objects>
</document>
